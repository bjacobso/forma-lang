opam-version: "2.0"
synopsis: "The OCaml compiler and interpreter engine for Forma"
description: "A typed Lisp engine targeting native code, JavaScript, and WebAssembly."
maintainer: "Ben Jacobson"
authors: "Ben Jacobson"
license: "MIT"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.17"}
  "js_of_ocaml" {with-test}
  "wasm_of_ocaml-compiler" {with-test}
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
]
